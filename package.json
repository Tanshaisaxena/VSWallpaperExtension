{
  "name": "pixel-pal",
  "displayName": "PixelPal",
  "publisher": "PixelPal-Studios",
  "description": "Display custom images and GIFs directly in the VS Code Explorer sidebar.",
  "version": "0.0.3",
  "private": false,
  "engines": {
    "vscode": "^1.60.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "gif",
    "image",
    "wallpaper",
    "sidebar",
    "explorer",
    "customization"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "activationEvents": [
    "onView:vswallpaper.explorer",
    "onCommand:vswallpaper.addImage",
    "onCommand:vswallpaper.browseGifs",
    "onCommand:vswallpaper.clearImage"
  ],
  "main": "./extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "vswallpaper.explorer",
          "name": "PixelPal"
        }
      ]
    },
    "commands": [
      {
        "command": "vswallpaper.addImage",
        "title": "+ Add",
        "category": "PixelPal",
        "icon": {
          "light": "./media/add.svg",
          "dark": "./media/add.svg"
        }
      },
      {
        "command": "vswallpaper.browseGifs",
        "title": "Browse GIFs",
        "category": "PixelPal",
        "icon": {
          "light": "./media/browse.svg",
          "dark": "./media/browse.svg"
        }
      },
      {
        "command": "vswallpaper.clearImage",
        "title": "Clear Wallpaper",
        "category": "PixelPal",
        "icon": {
          "light": "./media/clear.svg",
          "dark": "./media/clear.svg"
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vswallpaper.addImage",
          "when": "view == vswallpaper.explorer",
          "group": "navigation"
        },
        {
          "command": "vswallpaper.browseGifs",
          "when": "view == vswallpaper.explorer",
          "group": "navigation"
        },
        {
          "command": "vswallpaper.clearImage",
          "when": "view == vswallpaper.explorer",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "VS Wallpaper Settings",
      "properties": {
        "vswallpaper.klipyAppKey": {
          "type": "string",
          "default": "",
          "description": "Your KLIPY App Key for GIF search and trending GIFs."
        },
        "vswallpaper.klipyCustomerId": {
          "type": "string",
          "default": "",
          "description": "Optional KLIPY customer ID. If empty, a stable local customer ID is generated automatically."
        }
      }
    }
  },
  "license": "MIT",
  "qna": false,
  "scripts": {
    "check": "node --check extension.js",
    "vscode:prepublish": "npm run check"
  }
}
